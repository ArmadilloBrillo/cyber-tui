# --- Runtime mode ---
# Set to 1 for mock data (no credentials needed, useful for UI development)
CYBERSPACE_USE_MOCK=0

# --- API ---
# Only set this to override the default (https://api.cyberspace.online)
# Useful for pointing at a local proxy or staging environment
# CYBERSPACE_API_BASE_URL=https://api.cyberspace.online

# --- Dev convenience ---
# Pre-fill credentials so the app logs in automatically on startup.
# Keep this file out of version control when real values are set (.env is gitignored).
CYBERSPACE_EMAIL=you@example.com
CYBERSPACE_PASSWORD=your_password_here

# --- SSH server mode (optional) ---
# Leave SSH_LISTEN_ADDR blank to run as a local TUI (default)
SSH_HOST_KEY_PATH=./ssh_host_key
SSH_LISTEN_ADDR=
